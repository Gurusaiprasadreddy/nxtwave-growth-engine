# AI Workshop Growth Engine - Environment Configuration
# Copy this file to .env and adjust values as needed

# Backend Settings
DATABASE_URL=sqlite:///./growth_engine.db
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8000

# Simulation Settings
SIMULATION_TARGET=500
SIMULATION_BUDGET=2000
SIMULATION_DAYS=7

# LLM API (Optional - Plug in to enable real AI insights)
# OPENAI_API_KEY=sk-...
# GOOGLE_GEMINI_API_KEY=AIza...
# LLM_PROVIDER=gemini   # "openai" | "gemini" | "none" (deterministic fallback)

# Frontend (for dev mode only)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
